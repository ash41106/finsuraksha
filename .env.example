# FinSuraksha configuration - copy this file to ".env" and fill in what you need.
# NOTHING here is required: the whole site runs without any key.

PORT=3000

# --- Suraksha-Dost AI mode (optional) ---------------------------------------
# Adds replies in 10 Indian languages, richer explanations and (with the
# user's consent) screenshot reading, via Google Gemini.
# Without a key, the rule-based engine answers in English/Hindi.
# Create a free key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# FS_AI_MODEL=gemini-2.5-flash   # or gemini-2.5-flash-lite / gemini-2.5-pro
# Fallback provider, used only when GEMINI_API_KEY is empty:
# https://console.groq.com/keys
GROQ_API_KEY=
# FS_AI_EFFORT=low        # low | medium | high (higher = slower)

# --- Live link reputation (optional) ----------------------------------------
# Google Safe Browsing Lookup API v4 key (non-commercial use; for a commercial
# deployment use Google Web Risk instead).
GOOGLE_SAFE_BROWSING_API_KEY=

# --- SEBI registration lookup service (optional) ----------------------------
# Only used for numbers that are NOT in the local register
# (seed/sebi_register_snapshot.json). The service gets GET <url>?regNo=INA...
# with "Authorization: Bearer <key>" and must answer
# {"found": true, "name": "...", "type": "..."} or {"found": false}.
# Answers are cached for 24 hours.
SEBI_LOOKUP_URL=
SEBI_LOOKUP_KEY=

# --- Community settings -----------------------------------------------------
# Emails that get moderator rights when they sign up (comma-separated).
MODERATOR_EMAILS=
# Matching community votes needed to verify (or reject) a report.
VERIFY_THRESHOLD=3
# Load sample hunters and reports on first run (shown with a "Sample" label).
SEED_DEMO=true

# --- Deployment (see DEPLOY.md) ---------------------------------------------
# NODE_ENV=production
# Public address of the site, no trailing slash.
# PUBLIC_URL=https://finsuraksha.example
# true when served over HTTPS (secure cookies + HSTS).
COOKIE_SECURE=false
# 1 behind one reverse proxy (Caddy, nginx, Render, Railway), so rate limits
# and the origin check see the real client and host. Never set it without a proxy.
TRUST_PROXY=false
# Other sites allowed to call the API (comma-separated). Usually empty.
# ALLOWED_ORIGINS=
# DATA_DIR=./data
# First moderator account, created at start-up if it doesn't exist.
# Password: 8+ characters with a letter and a number. Remove it after first start.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Grievance / contact address shown on the Privacy and Terms pages.
# CONTACT_EMAIL=
# Multiply every rate limit, e.g. 3 for a campus event behind one IP.
# RATE_LIMIT_SCALE=1
# LOG_REQUESTS=false
